# ==============================================================================
# Cognify Environment Configuration Example
# Copy this file to .env locally and populate with your own service credentials.
# NEVER commit your real .env or .env.local file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Supabase Configuration (Backend)
# Create a project at https://supabase.com/
# Settings -> API Keys:
# - Project URL: https://<project-ref>.supabase.co
# - Secret Key (modern): sb_secret_... (or legacy service_role key)
# - Publishable Key (modern): sb_publishable_... (or legacy anon key)
# NEVER expose SUPABASE_SECRET_KEY to frontend code or client bundles!
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Legacy key fallbacks (optional)
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here
# SUPABASE_ANON_KEY=your_legacy_anon_key_here

# ------------------------------------------------------------------------------
# Frontend Supabase Configuration (Vite environment variables)
# In Vite, variables exposed to the browser MUST start with VITE_
# Configure these in frontend/.env.local or Vercel Environment Variables.
# NEVER place SUPABASE_SECRET_KEY or GEMINI_API_KEY in frontend variables!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ------------------------------------------------------------------------------
# Application Server & Networking
# ------------------------------------------------------------------------------
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads
NODE_ENV=development
