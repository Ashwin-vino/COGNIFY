# ==============================================================================
# Cognify Frontend Environment Variables (.env.example)
# Copy to frontend/.env.local and replace placeholders with real keys.
# NEVER place SUPABASE_SECRET_KEY or GEMINI_API_KEY in frontend variables!
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
